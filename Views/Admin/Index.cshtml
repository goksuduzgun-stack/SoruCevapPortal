@model SoruCevapPortal.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Yönetim Paneli";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Yönetim Paneli</h1>
        <p class="text-secondary mb-0">Portal içeriğini buradan yönetin.</p>
    </div>
    <a asp-action="CreateQuestion" class="btn btn-primary">Yeni Soru Ekle</a>
</div>
@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<div class="row g-3">
    <div class="col-md-4"><div class="card stat-card"><div class="card-body"><div class="text-secondary">Sorular</div><div class="display-6 fw-semibold">@Model.QuestionCount</div><a asp-action="Questions">Soruları yönet</a></div></div></div>
    <div class="col-md-4"><div class="card stat-card"><div class="card-body"><div class="text-secondary">Cevaplar</div><div class="display-6 fw-semibold">@Model.AnswerCount</div><span class="text-muted">Veritabanı kayıtları</span></div></div></div>
    <div class="col-md-4"><div class="card stat-card"><div class="card-body"><div class="text-secondary">Kategoriler</div><div class="display-6 fw-semibold">@Model.CategoryCount</div><a asp-action="Categories">Kategorileri yönet</a></div></div></div>
</div>
