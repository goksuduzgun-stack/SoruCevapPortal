@model List<SoruCevapPortal.Models.Question>
@{
    ViewData["Title"] = "Soruları Yönet";
    var categories = ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">Soruları Yönet</h1>
        <p class="text-secondary mb-0">Soruları ekleyin, düzenleyin veya silin.</p>
    </div>
    <a asp-action="Add" class="btn btn-primary">Yeni Soru</a>
</div>
@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
<form method="get" class="row g-2 mb-3" id="questionFilter">
    <div class="col-md-7">
        <label for="questionSearch" class="visually-hidden">Sorularda ara</label>
        <input id="questionSearch" name="search" value="@ViewBag.Search" class="form-control" placeholder="Başlık veya içerikte ara" autocomplete="off" />
    </div>
    <div class="col-md-3">
        <label for="categoryId" class="visually-hidden">Kategori</label>
        <select id="categoryId" name="categoryId" asp-items="categories" class="form-select">
            <option value="">Tüm kategoriler</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100">Filtrele</button></div>
</form>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Başlık</th><th>Kategori</th><th>Cevap</th><th>Eklenme tarihi</th><th class="text-end">İşlem</th></tr></thead>
            <tbody id="questionRows">
            @foreach (var question in Model)
            {
                <tr>
                    <td>@question.Title</td>
                    <td>@question.Category?.Name</td>
                    <td>@question.Answers.Count</td>
                    <td>@question.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Update" asp-route-id="@question.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@question.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<p id="emptyQuestions" class="text-muted mt-3" hidden>Aramanızla eşleşen soru bulunamadı.</p>
@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
